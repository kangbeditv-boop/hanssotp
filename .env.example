# ============================================
# OTP SERVICE - Environment Configuration
# Copy this file to backend/.env
# ============================================

# Server
PORT=5000
NODE_ENV=production

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=otp_user
DB_PASSWORD=your_secure_password
DB_NAME=otp_service

# JWT Secrets (generate random strings)
JWT_SECRET=change_this_to_random_64_char_string
JWT_EXPIRES_IN=7d
JWT_ADMIN_SECRET=change_this_to_another_random_64_char_string
JWT_ADMIN_EXPIRES_IN=24h

# CORS (your frontend domain)
CORS_ORIGIN=https://yourdomain.com

# Tripay Payment Gateway
# Register: https://tripay.co.id
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_MODE=sandbox

# QRISPY Payment Gateway
QRISPY_API_KEY=
QRISPY_MERCHANT_ID=

# OTP Providers
# 5sim.net: https://5sim.net
FIVESIM_API_KEY=
# Hero SMS
HEROSMS_API_KEY=
# Nokosmurah
NOKOSMURAH_API_KEY=

# Telegram Bot (optional)
# Create bot via @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
RESELLER_RATE_LIMIT_MAX=60
