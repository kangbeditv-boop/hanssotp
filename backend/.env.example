# Server
PORT=5000
NODE_ENV=production

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=otp_user
DB_PASSWORD=your_db_password
DB_NAME=otp_service

# JWT
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRES_IN=7d
JWT_ADMIN_SECRET=your_admin_jwt_secret_change_this
JWT_ADMIN_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=https://yourdomain.com

# Tripay Payment Gateway
TRIPAY_API_KEY=your_tripay_api_key
TRIPAY_PRIVATE_KEY=your_tripay_private_key
TRIPAY_MERCHANT_CODE=your_tripay_merchant_code
TRIPAY_MODE=sandbox

# QRISPY Payment Gateway
QRISPY_API_KEY=your_qrispy_api_key
QRISPY_MERCHANT_ID=your_qrispy_merchant_id

# Pakasir Payment Gateway
PAKASIR_PROJECT=your_pakasir_project_name
PAKASIR_NET_KEY=your_pakasir_net_key
PAKASIR_MODE=sandbox

# OTP Providers
FIVESIM_API_KEY=your_5sim_api_key
HEROSMS_API_KEY=your_herosms_api_key
NOKOSMURAH_API_KEY=your_nokosmurah_api_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
RESELLER_RATE_LIMIT_MAX=60
